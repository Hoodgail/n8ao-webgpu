{
  "name": "n8ao-webgpu",
  "version": "1.0.0",
  "description": "Screen-space ambient occlusion for Three.js TSL and WebGPU.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "license": "CC0-1.0",
  "author": "Hoodgail Benjamin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hoodgail/n8ao-webgpu.git"
  },
  "bugs": {
    "url": "https://github.com/Hoodgail/n8ao-webgpu/issues"
  },
  "homepage": "https://hoodgail.github.io/n8ao-webgpu/",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "three": "~0.186.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "^22.0.0",
    "@types/three": "0.186.0",
    "marked": "^17.0.6",
    "prettier": "^3.6.0",
    "three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "^7.3.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:docs": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.website.json --noEmit",
    "test": "npm run build && node --test tests/unit/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "npm run typecheck && npm test && npm run build:docs",
    "format": "prettier --write src examples website docs tests/unit tests/browser/*.js tests/browser/index.html index.html *.md *.json *.ts scripts .github --ignore-path .prettierignore",
    "prepack": "npm run check"
  }
}
